//! Typed AWS credentials, refresh and the credential_process protocol.
use std::os
use std::datetime
use std::process
use std::string

fn header_value(value: str) -> bool {
  for byte in value.bytes() { if byte < 32 || byte == 127 { return false } }
  return true
}

pub struct Credentials(
  pub access_key: str,
  pub secret_key: str,
  pub session_token: str? = nil,
  pub expires_at: float? = nil,
) {
  pub fn validate(self, now: float) -> Result<nil, str> {
    if self.access_key.len() == 0 || self.access_key.contains("/") ||
       self.access_key.contains(" ") || self.access_key.contains(",") ||
       !header_value(self.access_key) || self.secret_key.len() == 0 {
      return .Err("credential provider returned invalid credentials")
    }
    let token = self.session_token
    if token is not nil && (token.len() == 0 || !header_value(token)) {
      return .Err("credential provider returned an invalid session token")
    }
    let expiry = self.expires_at
    if expiry is not nil && expiry <= now { return .Err("credential provider returned expired credentials") }
    return .Ok(nil)
  }
}

schema ProcessCredentials {
  Version: int,
  AccessKeyId: str,
  SecretAccessKey: str,
  SessionToken: str?,
  Expiration: str?,
}

fn process_credentials(text: str) -> Result<Credentials, str> {
  let output = match ProcessCredentials.from_json(text) {
    .Ok(value) => value,
    .Err(_) => { return .Err("credential process returned invalid JSON credentials") },
  }
  if output.Version != 1 { return .Err("credential process requires protocol Version 1") }
  var expires_at: float? = nil
  let expiration = output.Expiration
  if expiration is not nil {
    let date = match datetime.parse_rfc3339(expiration) {
      .Ok(value) => value,
      .Err(_) => { return .Err("credential process returned invalid Expiration") },
    }
    expires_at = date.timestamp
  }
  return .Ok(Credentials {
    access_key: output.AccessKeyId, secret_key: output.SecretAccessKey,
    session_token: output.SessionToken, expires_at: expires_at,
  })
}

/// Providers run synchronously before signing. Cached instances are process-local
/// and must be created inside a worker when runtimes do not share mutable heaps.
pub struct CredentialProvider(pub load: fn() -> Result<Credentials, str>) {
  pub fn resolve(self, now: float? = nil) -> Result<Credentials, str> {
    let credentials = (self.load)()?
    credentials.validate(now ?? os.time())?
    return .Ok(credentials)
  }

  pub fn fixed(credentials: Credentials) -> CredentialProvider {
    return CredentialProvider { load: || .Ok(credentials) }
  }

  /// Read current AWS environment variables on every resolution, allowing rotation.
  pub fn environment() -> CredentialProvider {
    return CredentialProvider { load: || {
      let access = os.getenv("AWS_ACCESS_KEY_ID")
      let secret = os.getenv("AWS_SECRET_ACCESS_KEY")
      if access is nil || secret is nil {
        return .Err("AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are required")
      }
      return .Ok(Credentials {
        access_key: access, secret_key: secret, session_token: os.getenv("AWS_SESSION_TOKEN"),
      })
    } }
  }

  /// Execute argv directly, never through a shell. Output/errors never include secrets.
  /// Use cached() to refresh expiring credentials before the next signature.
  pub fn process(program: str, args: [str], timeout_ms: int = 30000) -> CredentialProvider {
    let command_args = args.slice()
    return CredentialProvider { load: || {
      let result = match process.run(program, command_args, process::RunOptions {
        timeout_ms: timeout_ms, max_output_bytes: 65536,
      }) {
        .Ok(value) => value,
        .Err(_) => { return .Err("credential process could not complete") },
      }
      if result.status != 0 { return .Err("credential process exited unsuccessfully") }
      return process_credentials(string.from_bytes(result.stdout))
    } }
  }

  /// Delegate profile/SSO/role resolution to AWS CLI's documented JSON protocol.
  /// The executable is configurable. This provider does not install or log in.
  pub fn aws_profile(profile: str? = nil, program: str = "aws") -> CredentialProvider {
    let args = ["configure", "export-credentials", "--format", "process",
                "--no-cli-pager", "--no-cli-auto-prompt"]
    if profile is not nil { args.push("--profile"); args.push(profile) }
    return CredentialProvider::process(program, args).cached()
  }

  /// Refresh before expiration; failed refresh is an error, never stale credentials.
  /// Credentials without Expiration are cached indefinitely, as in AWS's protocol.
  pub fn cached(self,
    refresh_before_seconds: float = 300,
    clock: fn() -> float = || os.time(),
  ) -> CredentialProvider {
    let cache: [Credentials] = []
    return CredentialProvider { load: || {
      if refresh_before_seconds < 0 { return .Err("credential refresh window must not be negative") }
      let now = clock()
      if cache.len() > 0 {
        let current = cache[0]
        let expiry = current.expires_at
        if expiry is nil || expiry > now + refresh_before_seconds {
          current.validate(now)?
          return .Ok(current)
        }
      }
      let fresh = self.resolve(now)?
      if cache.len() == 0 { cache.push(fresh) } else { cache[0] = fresh }
      return .Ok(fresh)
    } }
  }
}

@test
fn credentials_refresh_at_boundary_and_fail_closed() {
  let now = [1000.0]
  let calls = [0]
  let fail = [false]
  let source = CredentialProvider { load: || {
    calls[0] += 1
    if fail[0] { return .Err("provider unavailable") }
    return .Ok(Credentials {
      access_key: "access", secret_key: "secret",
      session_token: "token-{calls[0]}", expires_at: now[0] + 600,
    })
  } }
  let cached = source.cached(60, || now[0])
  expect(cached.resolve(now[0]).unwrap().session_token).to_eq("token-1")
  now[0] = 1539.0
  expect(cached.resolve(now[0]).unwrap().session_token).to_eq("token-1")
  now[0] = 1540.0
  expect(cached.resolve(now[0]).unwrap().session_token).to_eq("token-2")
  expect(calls[0]).to_eq(2)
  now[0] = 2080.0
  fail[0] = true
  expect(cached.resolve(now[0]).is_err()).to_eq(true)
  expect(calls[0]).to_eq(3)
}

@test
fn credential_process_protocol_and_redacted_errors() {
  let value = process_credentials("\{\"Version\":1,\"AccessKeyId\":\"access\",\"SecretAccessKey\":\"secret\",\"Expiration\":\"1970-01-01T01:00:00+01:00\"}").unwrap()
  expect(value.expires_at).to_eq(0.0)
  expect(value.validate(0).is_err()).to_eq(true)
  expect(process_credentials("\{\"Version\":2,\"AccessKeyId\":\"access\",\"SecretAccessKey\":\"secret\"}").is_err()).to_eq(true)
  expect(process_credentials("\{\"Version\":1,\"AccessKeyId\":\"access\",\"SecretAccessKey\":\"secret\",\"Expiration\":\"2023-02-29T00:00:00Z\"}").is_err()).to_eq(true)
  expect(process_credentials("\{\"Version\":1,\"AccessKeyId\":55,\"SecretAccessKey\":\"secret\"}").is_err()).to_eq(true)
  let stable = CredentialProvider::fixed(Credentials { access_key: "access", secret_key: "secret" }).cached()
  expect(stable.resolve().unwrap().access_key).to_eq("access")
}